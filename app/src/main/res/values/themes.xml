<?xml version="1.0" encoding="utf-8"?>
<!--
    Base app theme. The real colors/typography live in Compose (SLTaskerTheme);
    this XML theme only styles the window before the first frame is drawn, so
    the cold-start splash matches the OLED background and system bars stay
    transparent for edge-to-edge.
-->
<resources>
    <style name="Theme.SLTasker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
